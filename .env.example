# Church Member Management System (CMMS) Environment Variables
NODE_ENV=development
PORT=3000

# Gemini API Key (Server-side AI Features)
GEMINI_API_KEY=

# Supabase Configuration (Frontend & Authentication)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Distributed Cache & Rate Limiter (Optional - Horizontally Scaled Deployments)
REDIS_URL=

# Public Prayer Form Routing (set verified IDs per environment; never use client input)
CMMS_PUBLIC_PRAYER_TENANT_ID=
CMMS_PUBLIC_PRAYER_BRANCH_ID=

# PostgreSQL Direct Connection (Offline-capable local / remote database)
DATABASE_URL=postgres://user:pass@localhost:5432/cmms

# Authentication Secret (for custom backend tokens)
JWT_SECRET=

# Ethio Telecom & SMS Provider Credentials (Backend-Only - NEVER prefix with VITE_)
SMS_PROVIDER=EthioTelecom
SMS_API_URL=https://api.ethiotelecom.et/sms/v1/send
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
ETHIO_TELECOM_SMS_URL=https://api.ethiotelecom.et/sms/v1/send
ETHIO_TELECOM_APP_ID=
ETHIO_TELECOM_APP_SECRET=
ETHIO_TELECOM_SENDER_ID=

# Email Provider & SMTP Credentials (Backend-Only - NEVER prefix with VITE_)
EMAIL_PROVIDER=SMTP
EMAIL_FROM="New Church CMMS <noreply@example.org>"
EMAIL_REPLY_TO=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# External API Integration Master Key
CMMS_EXTERNAL_API_MASTER_KEY=

# Test Suite Deterministic Token Bypass (NEVER set in production or staging)
ALLOW_TEST_TOKENS=

# YouVersion Platform API Key (Server-Side Proxy Strictly)
YOUVERSION_APP_KEY=
YOUVERSION_API_BASE_URL=https://api.youversion.com/v1

